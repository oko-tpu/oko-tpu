{
  "name": "oko-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cross-env OKO_MODE=backend vite",
    "dev:prism": "cross-env OKO_MODE=prism vite",
    "mock": "node mock/server.mjs",
    "mock:prism": "prism mock ../contracts/oko-openapi.yaml -p 4010",
    "demo": "node scripts/demo.mjs",
    "test-pages": "node scripts/test-pages.mjs",
    "build": "tsc -b && vite build",
    "build:widget": "node scripts/build-widget.mjs",
    "gen:api": "openapi-typescript ../contracts/oko-openapi.yaml -o src/api/schema.d.ts",
    "typecheck": "tsc -b",
    "test": "vitest run && node scripts/build-widget.mjs",
    "test:widget": "node scripts/widget-e2e.mjs",
    "build:deploy": "node scripts/build-deploy.mjs"
  },
  "dependencies": {
    "@mantine/charts": "^8.3.18",
    "@mantine/core": "^8.3.18",
    "@mantine/dates": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@mantine/notifications": "^8.3.18",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-query": "^5.107.1",
    "dayjs": "^1.11.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.16.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.32",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
